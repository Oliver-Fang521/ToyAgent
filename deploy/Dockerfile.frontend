FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY sites/agent-web/package.json sites/agent-web/package-lock.json ./
RUN npm ci --include=dev --include=optional --no-audit --no-fund
COPY sites/agent-web/ ./
ENV NODE_ENV=production SITES_EXECUTION_PROFILE=portable
RUN node scripts/run-framework.mjs build
FROM node:22-bookworm-slim
WORKDIR /app
RUN groupadd -g 10001 toyagent && useradd -u 10001 -g 10001 -m toyagent
COPY --from=build --chown=10001:10001 /app /app
COPY --chown=10001:10001 deploy/local_frontend.mjs /app/local_frontend.mjs
ENV NODE_ENV=production HOME=/home/toyagent
USER 10001:10001
CMD ["node", "/app/local_frontend.mjs"]
