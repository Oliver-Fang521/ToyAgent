FROM ghcr.io/astral-sh/uv:0.11.3 AS uv
FROM python:3.12-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --python /usr/local/bin/python
COPY src ./src
COPY deploy/local_runtime.py deploy/local_backend.py deploy/local_backup.py ./deploy/
RUN uv sync --frozen --no-dev --python /usr/local/bin/python && groupadd -g 10001 toyagent && useradd -u 10001 -g 10001 -m toyagent && mkdir /data && chown 10001:10001 /data
ENV PATH="/app/.venv/bin:$PATH" HOME=/home/toyagent PYTHONUNBUFFERED=1
USER 10001:10001
CMD ["python", "/app/deploy/local_backend.py"]
